exit: 0
--- stdout
{
  "model": {
    "key": "carbon",
    "label": "Voyant Carbon (voyant-api 1.0.1, firmware FPGA v1.5.6 / MCU v4.1.0)"
  },
  "sensor_ip": "127.0.0.2",
  "data_port": 5678,
  "multicast_group": "239.255.48.84",
  "interface_address": "127.0.0.1",
  "interface_from": "route to SENSOR_IP",
  "sensor_register_address": "127.0.0.2:1234",
  "topic": "/point_cloud",
  "metadata_topic": "/device_metadata",
  "frame_id": "voyant_sensor",
  "time_mode": "sensor",
  "params_file": "/tmp/voyant/params.yaml",
  "parameters": {
    "binding_address": "0.0.0.0:5678",
    "multicast_group": "239.255.48.84",
    "interface_address": "127.0.0.1",
    "fpga_target_address": "127.0.0.2:1234",
    "stream_transport": "unicast",
    "observer_only": false,
    "diagnostic_mode": false,
    "timestamp_mode": 0,
    "frame_id": "voyant_sensor"
  },
  "argv": [
    "/ros2_ws/install/voyant_ros/lib/voyant_ros/voyant_sensor_node",
    "--ros-args",
    "-r",
    "point_cloud:=point_cloud",
    "--params-file",
    "/tmp/voyant/params.yaml"
  ],
  "sources": {
    "DATA_PORT": "default",
    "DEVICE_PORT": "default",
    "FRAME_ID": "default",
    "HOST_IP": "default",
    "LIDAR_MODEL": "env",
    "POINTCLOUD_TOPIC": "default",
    "PUBLISH_SCAN": "default",
    "SENSOR_ID": "default",
    "SENSOR_IP": "env",
    "TIME_MODE": "default",
    "VOYANT_RUN_DIR": "default"
  },
  "params_yaml": "# Rendered from the environment by the voyant-driver image entrypoint; do not edit.\n# LIDAR_MODEL carbon = Voyant Carbon (voyant-api 1.0.1, firmware FPGA v1.5.6 / MCU v4.1.0); SENSOR_IP 127.0.0.2; the client receives on port 5678 (127.0.0.1) and is the sensor's primary client\n# TIME_MODE sensor: the sensor's frame time (its clock disciplined to the host's)\n# topic /point_cloud, frame voyant_sensor\n/**:\n  ros__parameters:\n    binding_address: \"0.0.0.0:5678\"  # DATA_PORT on every address\n    multicast_group: \"239.255.48.84\"  # the vendor's default group\n    interface_address: \"127.0.0.1\"  # the host's address on the sensor network (route to SENSOR_IP)\n    fpga_target_address: \"127.0.0.2:1234\"  # SENSOR_IP: the sensor's register port (push destination, clock, SDL)\n    stream_transport: \"unicast\"  # the sensor sends to this client only (the vendor's default)\n    observer_only: false  # this driver is the sensor's one primary client (it configures the sensor and its clock)\n    diagnostic_mode: false  # valid points only, as the vendor's default\n    timestamp_mode: 0  # TIME_MODE sensor: the sensor's frame time (TIME_FROM_SENSOR)\n    frame_id: \"voyant_sensor\"  # FRAME_ID\n"
}
--- stderr
