exit: 1
--- stdout
{
  "refused": [
    "LIDAR_MODEL is not set; accepted (any case, '_' or '-', optional 'voyant-' prefix): meadowlark, mdl, carbon-dev-kit, carbon-devkit",
    "SENSOR_IP is not set; accepted: the sensor's own IPv4 address, for example 192.168.20.20 (the Meadowlark factory address)"
  ]
}
