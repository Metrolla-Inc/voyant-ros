exit: 0
--- stdout
# Rendered from the environment by the voyant-driver image entrypoint; do not edit.
# LIDAR_MODEL carbon = Voyant Carbon (voyant-api 1.0.1, firmware FPGA v1.5.6 / MCU v4.1.0); SENSOR_IP 192.168.1.128; the client receives on port 5678 (192.168.1.100) and is the sensor's primary client
# TIME_MODE sensor: the sensor's frame time (its clock disciplined to the host's)
# topic /east/point_cloud, frame east_lidar
/**:
  ros__parameters:
    binding_address: "0.0.0.0:5678"  # DATA_PORT on every address
    multicast_group: "239.255.48.84"  # the vendor's default group
    interface_address: "192.168.1.100"  # the host's address on the sensor network (HOST_IP)
    fpga_target_address: "192.168.1.128:1234"  # SENSOR_IP: the sensor's register port (push destination, clock, SDL)
    stream_transport: "unicast"  # the sensor sends to this client only (the vendor's default)
    observer_only: false  # this driver is the sensor's one primary client (it configures the sensor and its clock)
    diagnostic_mode: false  # valid points only, as the vendor's default
    timestamp_mode: 0  # TIME_MODE sensor: the sensor's frame time (TIME_FROM_SENSOR)
    frame_id: "east_lidar"  # FRAME_ID
# exec: /ros2_ws/install/voyant_ros/lib/voyant_ros/voyant_sensor_node --ros-args -r __ns:=/east -r point_cloud:=point_cloud --params-file /tmp/voyant/params.yaml
--- stderr
