exit: 0
--- stdout
# Rendered from the environment by the voyant-driver image entrypoint; do not edit.
# LIDAR_MODEL meadowlark = Voyant Carbon Dev Kit (Meadowlark, device id MDL-nnn); SENSOR_IP 192.168.20.20 (the driver joins the multicast group 224.0.0.0 on port 4444 and does not filter by sender)
# TIME_MODE host: frames are stamped with the host's clock as they arrive
# topic /east/point_cloud, frame east_lidar
/**:
  ros__parameters:
    binding_address: "0.0.0.0:4444"  # DATA_PORT on every address (the multicast stream)
    multicast_group: "224.0.0.0"  # the Meadowlark stream's group
    interface_address: "192.168.20.100"  # join the group on this host address (HOST_IP)
    spn_filter: true  # publish valid points only (drop_reason SUCCESS), as the released image does
    timestamp_mode: 0  # TIME_MODE host: the client's frame stamp (host clock)
    frame_id: "east_lidar"  # FRAME_ID
    point_format: 1  # MDL_STANDARD: x y z v snr drop_reason timestamp_nsecs point_idx
# exec: /ros2_ws/install/voyant_ros/lib/voyant_ros/voyant_sensor_node --ros-args -r __ns:=/east -r point_cloud:=point_cloud --params-file /tmp/voyant/params.yaml
--- stderr
