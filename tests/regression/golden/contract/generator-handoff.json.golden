exit: 0
--- stdout
{
  "model": {
    "key": "carbon",
    "label": "Voyant Carbon (voyant-api 1.0.1, firmware FPGA v1.5.6 / MCU v4.1.0)"
  },
  "sensor_ip": "192.168.1.128",
  "data_port": 5678,
  "multicast_group": "239.255.48.84",
  "interface_address": "192.168.1.100",
  "interface_from": "HOST_IP",
  "sensor_register_address": "192.168.1.128:1234",
  "topic": "/east/point_cloud",
  "metadata_topic": "/east/device_metadata",
  "frame_id": "east_lidar",
  "time_mode": "sensor",
  "params_file": "/tmp/voyant/params.yaml",
  "parameters": {
    "binding_address": "0.0.0.0:5678",
    "multicast_group": "239.255.48.84",
    "interface_address": "192.168.1.100",
    "fpga_target_address": "192.168.1.128:1234",
    "stream_transport": "unicast",
    "observer_only": false,
    "diagnostic_mode": false,
    "timestamp_mode": 0,
    "frame_id": "east_lidar"
  },
  "argv": [
    "/ros2_ws/install/voyant_ros/lib/voyant_ros/voyant_sensor_node",
    "--ros-args",
    "-r",
    "__ns:=/east",
    "-r",
    "point_cloud:=point_cloud",
    "--params-file",
    "/tmp/voyant/params.yaml"
  ],
  "sources": {
    "DATA_PORT": "env",
    "DEVICE_PORT": "default",
    "FRAME_ID": "env",
    "HOST_IP": "env",
    "LIDAR_MODEL": "env",
    "POINTCLOUD_TOPIC": "default",
    "PUBLISH_SCAN": "default",
    "SENSOR_ID": "env",
    "SENSOR_IP": "env",
    "TIME_MODE": "env",
    "VOYANT_RUN_DIR": "default"
  },
  "params_yaml": "# Rendered from the environment by the voyant-driver image entrypoint; do not edit.\n# LIDAR_MODEL carbon = Voyant Carbon (voyant-api 1.0.1, firmware FPGA v1.5.6 / MCU v4.1.0); SENSOR_IP 192.168.1.128; the client receives on port 5678 (192.168.1.100) and is the sensor's primary client\n# TIME_MODE sensor: the sensor's frame time (its clock disciplined to the host's)\n# topic /east/point_cloud, frame east_lidar\n/**:\n  ros__parameters:\n    binding_address: \"0.0.0.0:5678\"  # DATA_PORT on every address\n    multicast_group: \"239.255.48.84\"  # the vendor's default group\n    interface_address: \"192.168.1.100\"  # the host's address on the sensor network (HOST_IP)\n    fpga_target_address: \"192.168.1.128:1234\"  # SENSOR_IP: the sensor's register port (push destination, clock, SDL)\n    stream_transport: \"unicast\"  # the sensor sends to this client only (the vendor's default)\n    observer_only: false  # this driver is the sensor's one primary client (it configures the sensor and its clock)\n    diagnostic_mode: false  # valid points only, as the vendor's default\n    timestamp_mode: 0  # TIME_MODE sensor: the sensor's frame time (TIME_FROM_SENSOR)\n    frame_id: \"east_lidar\"  # FRAME_ID\n"
}
--- stderr
