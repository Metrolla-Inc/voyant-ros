exit: 0
--- stdout
# Rendered from the environment by the voyant-driver image entrypoint; do not edit.
# LIDAR_MODEL carbon = Voyant Carbon (voyant-api 1.0.1, firmware FPGA v1.5.6 / MCU v4.1.0); SENSOR_IP 10.20.0.20; the client receives on port 5700 (10.20.0.100) and is the sensor's primary client
# TIME_MODE host: the host's ROS clock when the node publishes
# topic /site/dock/points, frame dock_lidar
/**:
  ros__parameters:
    binding_address: "0.0.0.0:5700"  # DATA_PORT on every address
    multicast_group: "239.255.48.84"  # the vendor's default group
    interface_address: "10.20.0.100"  # the host's address on the sensor network (HOST_IP)
    fpga_target_address: "10.20.0.20:1234"  # SENSOR_IP: the sensor's register port (push destination, clock, SDL)
    stream_transport: "unicast"  # the sensor sends to this client only (the vendor's default)
    observer_only: false  # this driver is the sensor's one primary client (it configures the sensor and its clock)
    diagnostic_mode: false  # valid points only, as the vendor's default
    timestamp_mode: 1  # TIME_MODE host: the ROS clock (TIME_FROM_ROS)
    frame_id: "dock_lidar"  # FRAME_ID
# exec: /ros2_ws/install/voyant_ros/lib/voyant_ros/voyant_sensor_node --ros-args -r __ns:=/dock_2 -r point_cloud:=/site/dock/points --params-file /tmp/run/voyant/params.yaml
--- stderr
