    "DATA_PORT": "env",
    "DEVICE_PORT": "default",
    "FRAME_ID": "env",
    "HOST_IP": "env",
    "LIDAR_MODEL": "env",
    "POINTCLOUD_TOPIC": "env",
    "PUBLISH_SCAN": "env",
    "SENSOR_ID": "env",
    "SENSOR_IP": "env",
    "TIME_MODE": "env",
    "VOYANT_RUN_DIR": "env"
  },
  "params_yaml": "# Rendered from the environment by the voyant-driver image entrypoint; do not edit.\n# LIDAR_MODEL carbon = Voyant Carbon (voyant-api 1.0.1, firmware FPGA v1.5.6 / MCU v4.1.0); SENSOR_IP 10.20.0.20; the client receives on port 5700 (10.20.0.100) and is the sensor's primary client\n# TIME_MODE host: the host's ROS clock when the node publishes\n# topic /site/dock/points, frame dock_lidar\n/**:\n  ros__parameters:\n    binding_address: \"0.0.0.0:5700\"  # DATA_PORT on every address\n    multicast_group: \"239.255.48.84\"  # the vendor's default group\n    interface_address: \"10.20.0.100\"  # the host's address on the sensor network (HOST_IP)\n    fpga_target_address: \"10.20.0.20:1234\"  # SENSOR_IP: the sensor's register port (push destination, clock, SDL)\n    stream_transport: \"unicast\"  # the sensor sends to this client only (the vendor's default)\n    observer_only: false  # this driver is the sensor's one primary client (it configures the sensor and its clock)\n    diagnostic_mode: false  # valid points only, as the vendor's default\n    timestamp_mode: 1  # TIME_MODE host: the ROS clock (TIME_FROM_ROS)\n    frame_id: \"dock_lidar\"  # FRAME_ID\n"
}
