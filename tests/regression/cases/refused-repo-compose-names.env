# This repository's docker-compose.yaml environment with the switch on: its names are refused
# with the contract's.
LIDAR_MODEL=carbon
SENSOR_IP=192.168.1.128
HOST_IP=192.168.1.100
LIDAR_INTERFACE_DEV=eth0
VIZ_BRIDGE=false
ROS_LOCALHOST_ONLY=1
USE_MACADDRESS_NS=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
