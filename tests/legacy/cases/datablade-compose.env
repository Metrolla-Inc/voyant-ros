# datablade's docker-compose-ros2.yml met_lidar_driver service (the voyant-ros image line is
# commented out there; no fleet runs this driver): its environment and its command, which is
# Seyond's and was ignored by this image.
ROS_LOCALHOST_ONLY=1
USE_MACADDRESS_NS=0
ROS_LOG_DIR=/var/log/ros2
argv: /bin/bash -lc sleep 10; source /opt/ros/jazzy/setup.bash && ros2 launch seyond start.py continue_live:=True
