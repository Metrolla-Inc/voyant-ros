# This repository's docker-compose.yaml (used by no fleet): its environment and its command. The
# shell-form ENTRYPOINT ignored the command, so sensor_launch.py never ran.
ROS_LOCALHOST_ONLY=1
USE_MACADDRESS_NS=0
LIDAR_INTERFACE_DEV=eth0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
VIZ_BRIDGE=false
argv: ros2 launch voyant_ros sensor_launch.py
